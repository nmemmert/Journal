# Copy to .env — loaded by docker-compose via env_file

# SQLite path (used locally; docker-compose overrides this to /data/journal.db)
DATABASE_URL="file:./prisma/dev.db"

# Required: sign JWT sessions — generate with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-long-random-secret"

# Public URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
