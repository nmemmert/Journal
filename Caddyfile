# Replace journal.example.com with your actual domain.
# Caddy provisions and renews TLS automatically via Let's Encrypt.

journal.example.com {
    reverse_proxy journal:3000

    # Compress responses
    encode gzip

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Cache uploaded media
    @uploads path /uploads/*
    header @uploads Cache-Control "public, max-age=31536000, immutable"

    log {
        output stderr
        format console
    }
}
